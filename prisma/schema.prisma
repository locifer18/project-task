generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String           @id @default(cuid())
  employeeId         String?          @unique
  email              String           @unique
  name               String
  password           String
  role               String           @default("MEMBER") // "ADMIN" | "MEMBER"
  phone              String?
  bio                String?
  image              String?
  department         String?
  workingAs          String?
  dob                String?
  joiningDate        DateTime?
  githubProfile      String?
  isLogin            Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  milestones         Milestone[]
  projectMembers     ProjectMember[]
  featureRequests    FeatureRequest[]
  comments           Comment[]
  workDone           workDone[]
  notifications      Notification[]
  supervisedProjects ProjectInfo[]
}

model Project {
  id                String             @id @default(cuid())
  name              String
  summary           String?
  priority          String?
  basicDetails      String?
  repository        String?
  status            Int                @default(0)
  progress          Int                @default(0)
  currentPhase      String?            @default("Design")
  createdAt         DateTime           @default(now())
  assets            Asset[]
  milestones        Milestone[]
  members           ProjectMember[]
  tasks             Task[]
  featureRequests   FeatureRequest[]
  projectInfo       ProjectInfo?
  latestUpdates     LatestUpdate[]
  projectTechnology ProjectTechnology?
  designSystem      DesignSystem?
}

model ProjectInfo {
  id              String   @id @default(cuid())
  projectId       String   @unique
  budget          Float
  paidAmount      Float?   @default(0)
  clientName      String?
  projectType     String
  startDate       DateTime
  deadline        DateTime
  supervisorAdmin String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  supervisor      User?    @relation(fields: [supervisorAdmin], references: [id])
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectMember {
  id        String  @id @default(cuid())
  projectId String
  userId    String
  role      String?
  isLeader  Boolean @default(false)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Task {
  id             String    @id @default(cuid())
  title          String
  description    String
  assignee       String
  assigneeAvatar String?
  priority       String
  dueDate        DateTime
  employeeId     String?
  tags           String[]
  attachments    Json[]    @default([])
  status         String
  projectId      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  comments       Comment[]
  Project        Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  taskId    String
  userId    String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Report {
  id         String   @id @default(cuid())
  message    String
  taskId     String?
  reportedBy String?
  createdAt  DateTime @default(now())
}

model Milestone {
  id          String           @id @default(cuid())
  projectId   String
  title       String
  description String?
  dueDate     DateTime
  status      MILESTONE_STATUS @default(PENDING)
  createdBy   String
  createdAt   DateTime         @default(now())
  creator     User             @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Asset {
  id         String   @id @default(cuid())
  type       String
  url        String
  title      String
  uploadedBy String?
  userImage  String?
  publicId   String?
  liveUrl    String?
  projectId  String
  createdAt  DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Ticket {
  id               String   @id @default(cuid())
  projectId        String
  reportedBy       String
  reason           String
  blockedTeammates String[] @default([])
  createdAt        DateTime @default(now())
}

model FeatureRequest {
  id          String   @id @default(cuid())
  clientId    String
  projectId   String
  title       String
  description String
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  client      User     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model LatestUpdate {
  id        String   @id @default(cuid())
  title     String
  date      String
  projectId String
  createdBy String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model workDone {
  id          String   @id @default(cuid())
  projectId   String
  taskId      String   @unique
  title       String
  description String
  priority    String
  dueDate     DateTime
  tags        String[]
  userId      String
  completedBy User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OtpVerification {
  id        String   @id @default(cuid())
  email     String
  otp       String
  type      OtpType
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, type])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  image     String?
  type      String?
  meta      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DesignSystem {
  id               String   @id @default(uuid())
  projectId        String   @unique
  brandName        String
  colors           String[]
  fonts            Json
  designType       String[]
  layoutStyle      Json
  contentTone      String[]
  visualGuidelines Json
  theme            String[]
  brandFeel        String
  keyPages         String[]
  uniqueness       Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectTechnology {
  id        String   @id @default(cuid())
  projectId String   @unique
  tech      Json[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model RiskBlockage {
  id        String   @id @default(cuid())
  projectId String
  clientId  String
  riskTitle String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OtpType {
  SIGNUP
  FORGOT_PASSWORD
  LOGIN
}

enum MILESTONE_STATUS {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DELAYED
}
